---
import { getCollection } from "astro:content";
import { formatDate, preparePosts } from "../lib/blog";

const posts = preparePosts(await getCollection("blog")).slice(0, 3);
const colours = ["#155e75", "#5b21b6", "#9d174d", "#065f46", "#92400e"];
const colourOffset = Math.floor(Math.random() * colours.length);
---

{
  posts.length > 0 && (
    <section
      aria-labelledby="recent-posts-title"
      class="px-6 pb-12 pt-12 sm:pt-12 lg:px-8"
    >
      <div class="mx-auto max-w-[1152px]">
        <div class="mx-auto mb-8 max-w-[620px] text-center">
          <p class="text-sm font-semibold text-(--accent)">Blog</p>
          <h2
            id="recent-posts-title"
            class="mt-3 text-3xl font-bold leading-tight tracking-[-0.035em] text-(--text-primary) md:text-4xl"
          >
            Recent blog posts
          </h2>
        </div>
        <div
          class:list={[
            "grid gap-4 sm:gap-6",
            posts.length > 1 && "md:grid-cols-3",
          ]}
        >
          {posts.map((post, index) => (
            <a
              href={`/blog/${post.slug}`}
              style={`background-color: ${colours[(colourOffset + index) % colours.length]}`}
              class:list={[
                "flex min-w-0 flex-col justify-between gap-8 rounded-3xl p-7 text-white transition-[filter] hover:brightness-110 sm:p-9",
                index === 0 ? "min-h-64 md:col-span-2" : "min-h-40",
                index === 0 &&
                  posts.length === 3 &&
                  "md:row-span-2 md:min-h-96",
                posts.length === 2 && "md:min-h-80",
              ]}
            >
              <time datetime={post.postedDate} class="text-sm text-white/80">
                {formatDate(post.postedDate)}
              </time>
              <h3
                class:list={[
                  "wrap-break-word font-semibold leading-tight tracking-tight",
                  index === 0
                    ? "max-w-2xl text-3xl sm:text-4xl"
                    : "text-xl sm:text-2xl",
                ]}
              >
                {post.entry.data.title}
              </h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
