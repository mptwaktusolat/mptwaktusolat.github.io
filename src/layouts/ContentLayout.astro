---
import { House } from "@lucide/astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Layout from "./Layout.astro";

interface Props {
  frontmatter: {
    title: string;
    description: string;
    kind?: "changelog";
  };
}

const { frontmatter } = Astro.props;
const isChangelog = frontmatter.kind === "changelog";
---

<Layout
  title={`${frontmatter.title} | App Waktu Solat Malaysia | Malaysia Prayer Time App`}
  description={frontmatter.description}
>
  <main class="relative isolate min-h-screen overflow-hidden bg-(--page-bg)">
    <div
      class="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,var(--grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--grid-line)_1px,transparent_1px)] bg-size-[200px_200px] bg-position-[120px_0]"
      aria-hidden="true"
    >
    </div>
    <div
      class="hero-glow pointer-events-none absolute inset-x-0 top-[35%] h-[700px]"
      aria-hidden="true"
    >
    </div>

    <a
      href="/"
      data-home-link
      class="absolute left-8 top-5 z-20 flex items-center rounded-md bg-(--card-bg)/80 px-3 py-2 text-sm font-medium text-(--text-primary) backdrop-blur-sm transition-colors hover:bg-(--card-bg) sm:left-10 sm:top-6"
    >
      <House
        size={20}
        fill="currentColor"
        stroke-width={1.5}
        class="mr-1"
        aria-hidden="true"
      />
      Home
    </a>

    <div class="absolute right-6 top-4 z-20 text-(--text-primary) lg:right-8">
      <ThemeToggle />
    </div>

    <div
      class="relative mx-auto max-w-7xl px-6 pb-24 pt-10 sm:pb-32 lg:px-8 lg:py-32"
    >
      <div class="mx-auto max-w-4xl">
        <h1
          class="ml-3 mt-10 text-4xl font-bold tracking-tight text-(--text-primary) sm:text-6xl"
        >
          {frontmatter.title}
        </h1>
      </div>

      <article
        class:list={[
          "mx-auto mt-16 max-w-4xl text-base leading-6 text-(--text-primary) sm:mt-24 [&_a]:text-(--accent) [&_a]:hover:underline [&_li]:mt-2 [&_li]:marker:text-(--text-subtle) [&_p]:mb-6 [&_p]:mt-2 [&_strong]:font-bold [&_ul]:mb-2 [&_ul]:list-disc [&_ul]:pl-12",
          isChangelog
            ? "changelog-content [&_h2]:mb-5 [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:leading-tight sm:[&_h2]:text-4xl [&_img]:h-auto [&_img]:max-w-full [&_hr]:my-4 [&_hr]:h-10 [&_hr]:w-0.5 [&_hr]:border-0 [&_hr]:bg-gray-500"
            : "[&_h2]:mb-2 [&_h2]:mt-6 [&_h2]:text-3xl [&_h2]:font-medium",
        ]}
      >
        <slot />
      </article>
    </div>
  </main>
</Layout>

<style>
  :global(.changelog-content h2 .release-hash) {
    color: #0d9488;
    font-size: 1.25em;
    font-weight: 500;
    line-height: 1;
  }

  :global(.changelog-content h2 .release-date) {
    display: inline-block;
    font-size: 1rem;
    opacity: 0.5;
  }

  :global(.changelog-content h2 > a:last-child) {
    display: inline;
    margin-left: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    transition: opacity 150ms ease;
  }

  @media (hover: hover) {
    :global(.changelog-content h2 > a:last-child) {
      opacity: 0;
    }

    :global(.changelog-content h2:hover > a:last-child),
    :global(.changelog-content h2:focus-within > a:last-child) {
      opacity: 1;
    }
  }
</style>
