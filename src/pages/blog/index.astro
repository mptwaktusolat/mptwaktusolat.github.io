---
import { getCollection } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import BlogPostList from "../../components/BlogPostList.astro";
import { preparePosts } from "../../lib/blog";
const posts = preparePosts(await getCollection("blog"));
---

<BlogLayout
  title="Blog"
  description="News, ideas, and development stories from the Waktu Solat project."
>
  <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Blog</h1>
  <p class="mt-4 leading-7 text-(--text-muted)">
    News, ideas, and development stories from the Waktu Solat project.
  </p>
  <BlogPostList posts={posts} />
</BlogLayout>
